{
 "functions": {
  "api/fiche.js": {
   "maxDuration": 60
  },
  "api/img.js": {
   "maxDuration": 20
  },
  "api/publish.js": {
   "maxDuration": 30
  },
  "api/store.js": {
   "maxDuration": 60
  },
  "api/tts.js": {
   "maxDuration": 60
  }
 },
 "headers": [
  {
   "source": "/(.*)\\.(js|html)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache, must-revalidate"
    }
   ]
  },
  {
   "source": "/",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache, must-revalidate"
    }
   ]
  }
 ]
}